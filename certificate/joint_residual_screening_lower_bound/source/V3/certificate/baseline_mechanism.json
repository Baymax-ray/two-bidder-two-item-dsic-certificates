  "pointwise_rules": {
    "ordered_rule": "evaluate the hash-bound immediate predecessor first; if its first matching twenty-band row is S5.1 or S5.2, then apply the unique listed item row with t in (lower,upper]; otherwise retain the predecessor menu unchanged",
